# ============================================================================
# InsightIQ backend configuration. Copy to `.env` and fill in real values.
# NEVER commit a real .env (it is gitignored).
# ============================================================================

# --- Application ---
APP_NAME=InsightIQ
APP_ENV=development           # development | staging | production
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production the app refuses to start with the placeholder or a short key.
SECRET_KEY=changeme-generate-a-real-64-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Accepts postgres:// or postgresql+psycopg2:// (normalized automatically).
DATABASE_URL=postgresql+psycopg2://insightiq:insightiq@localhost:5432/insightiq
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS (JSON array or comma-separated) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- File storage ---
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
MAX_UPLOAD_SIZE_MB=100

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_CHAT=20/minute
# Leave empty for in-process memory; set to a Redis URL to share limits across
# gunicorn workers in production, e.g. redis://localhost:6379/3
RATE_LIMIT_STORAGE_URI=

# --- AI providers (optional; chat degrades gracefully if unset) ---
# Requires: pip install -r requirements-optional.txt
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Email (password reset / verification; logs to console if SMTP unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@insightiq.app
FRONTEND_URL=http://localhost:5173

# --- Google OAuth (optional) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Seed script credentials (python -m app.db.seed) ---
SEED_ADMIN_EMAIL=admin@insightiq.app
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@insightiq.app
SEED_DEMO_PASSWORD=
